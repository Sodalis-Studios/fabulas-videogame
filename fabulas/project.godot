[layer_names]

2d_render/layer_1="Player light"
2d_render/layer_2="World light"
2d_render/layer_3="Dark light"
2d_physics/layer_1="Player_Physics"
2d_physics/layer_2="Enemy_Physics"
2d_physics/layer_3="World"
2d_physics/layer_4="Player_Hurtbox"
2d_physics/layer_5="Enemy_Hitbox"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/decals/filter=0
textures/light_projectors/filter=0
