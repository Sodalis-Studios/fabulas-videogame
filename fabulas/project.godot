; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[accessibility]

general/updates_per_second=100

[application]

config/name="Fabulas"
config/description="Videojuego sobre un pájaro que tiene que escalar una torre saltando para llegar a unas alas y poder volar."
run/main_scene="uid://dkrk4ejombwic"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="uid://cwwn2kpes87na"

[audio]

buses/default_bus_layout="uid://dk4objfwo5k0y"

[autoload]

SceneManager="*res://shared/scene_manager/scene_manager.gd"
BrightnessManager="*uid://cfflrvml5sx2h"
SoundManager="*uid://b27b24o4dg0h8"
SignalBus="*uid://x0aqjjdx4sjo"
TransitionsScreen="*uid://d3q5v8lvhww64"
DebugMenu="*uid://b6g2tw8kh0d6y"
CheckpointManager="*uid://bc0he2ik862mq"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"
SettingsManager="*res://shared/settings/settings_manager.gd"
GameMenus="*res://ui/menus/game_menus/game_menus.tscn"
SaveManager="*res://shared/save/save_manager.gd"
InputDevice="*res://shared/input/input_device.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_ai/plugin.cfg")

[file_customization]

folder_colors={
"res://audio/": "red",
"res://entities/": "orange",
"res://entities/temporary_platform/audio/": "red",
"res://shared/": "pink",
"res://ui/": "teal",
"res://worlds/": "purple"
}

[global_group]

Route_A=""
Route_B=""
Route_C=""
player=""
brightness=""
physics=""
camera_rig=""

